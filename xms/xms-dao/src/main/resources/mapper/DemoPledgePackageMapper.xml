<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.DemoPledgePackageMapper">

    <resultMap type="DemoPledgePackage" id="DemoPledgePackageResult">
        <result property="id" column="id" />
        <result property="packageName" column="package_name" />
        <result property="pledgeUsdtAmount" column="pledge_usdt_amount" />
        <result property="releaseDays" column="release_days" />
        <result property="dailyRate" column="daily_rate" />
        <result property="status" column="status" />
        <result property="sort" column="sort" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
        <result property="deleted" column="deleted" />
    </resultMap>

    <sql id="selectDemoPledgePackageVo">
        select id, package_name, pledge_usdt_amount, release_days, daily_rate, status, sort,
               create_by, create_time, update_by, update_time, remark, deleted
        from t_demo_pledge_package
    </sql>

    <select id="selectDemoPledgePackageList" parameterType="DemoPledgePackage" resultMap="DemoPledgePackageResult">
        <include refid="selectDemoPledgePackageVo"/>
        <where>
            <if test="packageName != null and packageName != ''"> and package_name like concat('%', #{packageName}, '%')</if>
            <if test="status != null"> and status = #{status}</if>
            and deleted = 0
        </where>
        order by sort asc, id desc
    </select>
</mapper>
