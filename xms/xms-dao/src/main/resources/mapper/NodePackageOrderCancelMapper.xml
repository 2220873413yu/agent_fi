<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.NodePackageOrderCancelMapper">

    <resultMap type="NodePackageOrderCancel" id="NodePackageOrderCancelResult">
        <result property="id" column="id"/>
        <result property="originOrderId" column="origin_order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="address" column="address"/>
        <result property="hash" column="hash"/>
        <result property="packageLevel" column="package_level"/>
        <result property="directReferralRate" column="direct_referral_rate"/>
        <result property="indirectReferralRate" column="indirect_referral_rate"/>
        <result property="weightMultiplier" column="weight_multiplier"/>
        <result property="predOrderFeeReliefRate" column="pred_order_fee_relief_rate"/>
        <result property="orderValueUsdt" column="order_value_usdt"/>
        <result property="sourceType" column="source_type"/>
        <result property="status" column="status"/>
        <result property="bizStatus" column="biz_status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="payTime" column="pay_time"/>
        <result property="cancelTime" column="cancel_time"/>
        <result property="cancelBy" column="cancel_by"/>
        <result property="cancelReason" column="cancel_reason"/>
        <result property="releaseOrderId" column="release_order_id"/>
        <result property="releaseStatusBefore" column="release_status_before"/>
        <result property="releasedAmountSnapshot" column="released_amount_snapshot"/>
        <result property="remainingAmountSnapshot" column="remaining_amount_snapshot"/>
    </resultMap>

    <sql id="selectNodePackageOrderCancelVo">
        select id, origin_order_id, order_no, user_id, address, hash, package_level,
               direct_referral_rate, indirect_referral_rate, weight_multiplier,
               pred_order_fee_relief_rate, order_value_usdt, source_type, status, biz_status,
               create_time, update_time, pay_time, cancel_time, cancel_by, cancel_reason,
               release_order_id, release_status_before, released_amount_snapshot, remaining_amount_snapshot
        from t_node_package_order_cancel
    </sql>

    <select id="selectNodePackageOrderCancelList" parameterType="NodePackageOrderCancel" resultMap="NodePackageOrderCancelResult">
        <include refid="selectNodePackageOrderCancelVo"/>
        <where>
            <if test="originOrderId != null"> and origin_order_id = #{originOrderId}</if>
            <if test="orderNo != null and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="address != null and address != ''"> and address like concat('%', #{address}, '%')</if>
            <if test="hash != null and hash != ''"> and hash = #{hash}</if>
            <if test="packageLevel != null"> and package_level = #{packageLevel}</if>
            <if test="sourceType != null"> and source_type = #{sourceType}</if>
            <if test="status != null"> and status = #{status}</if>
            <if test="bizStatus != null"> and biz_status = #{bizStatus}</if>
            <if test="cancelBy != null and cancelBy != ''"> and cancel_by like concat('%', #{cancelBy}, '%')</if>
            <if test="releaseOrderId != null"> and release_order_id = #{releaseOrderId}</if>
            <if test="beginCancelTime != null and beginCancelTime != '' and endCancelTime != null and endCancelTime != ''">
                and cancel_time between #{beginCancelTime} and #{endCancelTime}
            </if>
        </where>
        order by id desc
    </select>
</mapper>
